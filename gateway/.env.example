# Generate a random value with: openssl rand -hex 32
# Do not commit the real .env file or put this key in index.html.
GATEWAY_API_KEY=replace-with-a-random-secret
# Exact origin only: scheme + host, no path, no wildcard. Change this before use.
ALLOWED_ORIGINS=https://replace-with-your-app-origin.invalid
# The Docker host-gateway target must be able to reach Ollama on the Docker bridge IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=1000
CACHE_MAX_RESPONSE_BYTES=1000000
MAX_REQUEST_BYTES=4000000
UPSTREAM_TIMEOUT_SECONDS=180
